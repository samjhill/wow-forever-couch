[Desktop Entry]
Type=Application
Version=1.0
Name=Install WoW Forever Couch
GenericName=WoW Forever Couch Setup
Comment=One-click install/update for Steam Deck & Bazzite (Battle.net, Forever addons, auto-sync)
# Works before clone (git clone) and after (local bootstrap). Prefer install.sh one-liner in Konsole when possible.
Exec=bash -lc 'set -e; REPO="$HOME/Projects/wow-forever-couch"; if [ ! -x "$REPO/scripts/bootstrap-steamos.sh" ]; then command -v git >/dev/null || { echo "Install git first"; read -r _; exit 1; }; mkdir -p "$HOME/Projects"; git clone https://github.com/samjhill/wow-forever-couch.git "$REPO"; fi; chmod +x "$REPO"/scripts/*.sh; exec "$REPO/scripts/bootstrap-steamos.sh"'
Icon=applications-games
Terminal=true
StartupNotify=true
Categories=Game;Utility;
Keywords=wow;forever;couch;steamdeck;bazzite;battlenet;consoleport;
