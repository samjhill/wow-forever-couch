# Sourced by scripts/lib.sh when WOW_COUCH_PROFILE=bazzite-nvidia.
# Matches the living-room Bazzite + NVIDIA couch box defaults.

export WOW_COUCH_PROFILE=bazzite-nvidia

export DXVK_FRAME_RATE="${DXVK_FRAME_RATE:-60}"
export PULSE_LATENCY_MSEC="${PULSE_LATENCY_MSEC:-60}"

# Couch dictation stack is part of the living-room setup.
export WOW_COUCH_DICTATION="${WOW_COUCH_DICTATION:-1}"

# Personal tuned prefs — only when you opt in on a private box.
export WOW_COUCH_RESTORE_LIVE="${WOW_COUCH_RESTORE_LIVE:-0}"
