# Sourced by scripts/lib.sh when WOW_COUCH_PROFILE=deck (or Steam Deck auto-detect).
# Override any value in your shell before launching scripts.

export WOW_COUCH_PROFILE=deck

# Gentler DXVK pacing for handheld thermals/battery (launch script reads these).
export DXVK_FRAME_RATE="${DXVK_FRAME_RATE:-40}"
export PULSE_LATENCY_MSEC="${PULSE_LATENCY_MSEC:-80}"

# Bootstrap defaults: skip Whisper/dictation unless explicitly enabled.
export WOW_COUCH_DICTATION="${WOW_COUCH_DICTATION:-0}"

# Do not auto-restore personal live-setup snapshot on public installs.
export WOW_COUCH_RESTORE_LIVE="${WOW_COUCH_RESTORE_LIVE:-0}"
